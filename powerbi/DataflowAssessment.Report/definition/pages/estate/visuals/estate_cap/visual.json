                }
              },
              "queryRef": "Dataflows.Dataflow Count",
              "nativeQueryRef": "Dataflow Count"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Workspaces"
                    }
                  },
                  "Property": "Capacity Resolution"
                }
              },
              "queryRef": "Workspaces.Capacity Resolution",
              "nativeQueryRef": "Capacity Resolution",
              "active": true
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
